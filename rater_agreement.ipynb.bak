    }
   },
   "outputs": [],
   "source": [
    "def usable(p, it):\n",
    "    a, b = p[f\"a_{it}\"], p[f\"b_{it}\"]\n",
    "    m = a.notna() & b.notna()\n",
    "    if it != \"no_sidewalk\":\n",
    "        m &= (p[\"a_no_sidewalk\"] != 1) & (p[\"b_no_sidewalk\"] != 1)\n",
    "    return m\n",
    "\n",
    "def categories(it, a, b):\n",
    "    if it in BINARY: return np.array([0, 1])\n",
    "    if it in CODES: return np.array(CODES[it])\n",
    "    return np.unique(np.concatenate([a, b]))\n",
    "\n",
    "def metrics(a, b, it):\n",
    "    n = len(a)\n",
    "    if n == 0: return dict(n=0)\n",
    "    cats = categories(it, a, b)\n",
    "    pa = np.array([(a == c).mean() for c in cats]); pb = np.array([(b == c).mean() for c in cats])\n",
    "    po = (a == b).mean()\n",
    "    pe = (pa * pb).sum()\n",
    "    kappa = (po - pe) / (1 - pe) if pe < 1 - 1e-12 else np.nan\n",
    "    pi = (pa + pb) / 2; K = len(cats)\n",
    "    pe1 = (pi * (1 - pi)).sum() / (K - 1) if K > 1 else np.nan\n",
    "    ac1 = (po - pe1) / (1 - pe1) if pe1 == pe1 and pe1 < 1 else np.nan\n",
    "    r = dict(n=n, agree=po, kappa=kappa, ac1=ac1)\n",
    "    if it in ORDINAL:\n",
    "        lo, hi = cats.min(), cats.max(); span = (hi - lo) or 1\n",
    "        w = 1 - np.abs(cats[:, None] - cats[None, :]) / span                 # linear weights\n",
    "        obs = np.array([[((a == x) & (b == y)).mean() for y in cats] for x in cats])\n",
    "        exp = np.outer(pa, pb)\n",
    "        r[\"w_kappa\"] = ((w * obs).sum() - (w * exp).sum()) / (1 - (w * exp).sum()) if (w * exp).sum() < 1 - 1e-12 else np.nan\n",
    "        r[\"within1\"] = (np.abs(a - b) <= 1).mean()\n",
    "    if it in BINARY:\n",
    "        r[\"prevalence\"] = (a.sum() + b.sum()) / (2 * n)\n",
    "    return r\n",
    "\n",
    "def strength(k):\n",
    "    if k != k: return \"n/a (one answer only)\"\n",
    "    return (\"Poor\" if k < 0 else \"Slight\" if k <= .2 else \"Fair\" if k <= .4 else \"Moderate\" if k <= .6\n",
    "            else \"Substantial\" if k <= .8 else \"Almost perfect\")\n",
    "\n",
    "def item_table(p, n_boot=N_BOOT, seed=SEED):\n",
    "    rng = np.random.default_rng(seed)\n",
    "    segs = p[\"segment\"].unique()\n",
    "    seg_idx = {s: np.flatnonzero(p[\"segment\"].values == s) for s in segs}\n",
    "    boots = [np.concatenate([seg_idx[s] for s in rng.choice(segs, len(segs))]) for _ in range(n_boot)]\n",
    "    rows = []\n",
    "    for it in ALL:\n",
    "        m = usable(p, it).values\n",
    "        a = p[f\"a_{it}\"].values; b = p[f\"b_{it}\"].values\n",
    "        r = dict(item=LABEL[it], key=it, **metrics(a[m], b[m], it))\n",
    "        r[\"segments\"] = p.loc[m, \"segment\"].nunique()\n",
    "        if n_boot and r[\"n\"] >= 5:\n",
    "            ag, ka, ac = [], [], []\n",
    "            for ix in boots:\n",
    "                ix = ix[m[ix]]\n",
    "                if len(ix) == 0: continue\n",
    "                mm = metrics(a[ix], b[ix], it); ag.append(mm[\"agree\"]); ka.append(mm[\"kappa\"]); ac.append(mm[\"ac1\"])\n",
    "            q = lambda v: np.nanpercentile(v, [2.5, 97.5]) if np.isfinite(v).any() else (np.nan, np.nan)\n",
    "            r[\"agree_lo\"], r[\"agree_hi\"] = q(np.array(ag)); r[\"kappa_lo\"], r[\"kappa_hi\"] = q(np.array(ka, float))\n",
    "            r[\"ac1_lo\"], r[\"ac1_hi\"] = q(np.array(ac, float))\n",
    "        rows.append(r)\n",
    "    t = pd.DataFrame(rows)\n",
    "    t[\"strength\"] = t[\"kappa\"].map(strength) if \"kappa\" in t else \"\"\n",
    "    return t\n",
    "\n",
    "RESULTS = {k: item_table(p) for k, p in COMPARISONS.items() if len(p)}"
   ]
  },
