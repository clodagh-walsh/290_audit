   ],
   "source": [
    "for it in ORDINAL + [\"q5_concrete\", \"q5_asphalt\", \"q7_none\", \"q8_none\"]:\n",
    "    sub = ratings[(ratings[\"no_sidewalk\"] != 1) & ratings[it].notna()]\n",
    "    tab = pd.crosstab([sub[\"method\"], sub[\"rater_id\"]], sub[it].astype(int), normalize=\"index\")\n",
    "    display(Markdown(f\"**{LABEL[it]}**\"))\n",
    "    display(tab.style.format(\"{:.0%}\").background_gradient(cmap=\"Greens\", axis=1))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "68cbb008",
   "metadata": {},
   "source": [
    "### Disagreements to review\n",
    "Every item where a pair answered differently, for checking against photos or Street View."
   ]
  },
