   "source": [
    "def disagreements(p, name):\n",
    "    rows = []\n",
    "    for it in ALL:\n",
    "        m = usable(p, it) & (p[f\"a_{it}\"] != p[f\"b_{it}\"])\n",
    "        for _, r in p[m].iterrows():\n",
    "            rows.append(dict(comparison=name, segment=r.segment, item=LABEL[it], rater_a=r.rater_a, value_a=r[f\"a_{it}\"],\n",
    "                             rater_b=r.rater_b, value_b=r[f\"b_{it}\"]))\n",
    "    return pd.DataFrame(rows)\n",
    "DIS = pd.concat([disagreements(p, k) for k, p in COMPARISONS.items() if len(p)], ignore_index=True)\n",
    "display(DIS.groupby([\"comparison\", \"item\"]).size().unstack(0).fillna(0).astype(int))\n",
    "DIS.head(20)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a723307f",
   "metadata": {},
   "source": [
    "## 8 · Save\n",
    "Writes every table to one Excel file next to this notebook."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "42cae4f2",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-11-20T16:36:14.795767Z",
     "iopub.status.busy": "2026-11-20T16:36:14.795593Z",
     "iopub.status.idle": "2026-11-20T16:36:15.074646Z",
     "shell.execute_reply": "2026-11-20T16:36:15.073642Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "saved Rockridge_rater_agreement.xlsx\n"
     ]
    }
   ],
   "source": [
    "with pd.ExcelWriter(EXPORT_XLSX) as xl:\n",
    "    overview.rename_axis(\"comparison\").to_excel(xl, sheet_name=\"Overview\")\n",
    "    for k, t in RESULTS.items():\n",
    "        t.drop(columns=\"key\").to_excel(xl, sheet_name=k.replace(\":\", \"\")[:31], index=False)\n",
    "    gq.to_excel(xl, sheet_name=\"Whole question\")\n",
    "    pd.concat([by_rater_pair(p).assign(comparison=k) for k, p in COMPARISONS.items() if len(p)])[\n",
    "        [\"comparison\", \"rater_a\", \"rater_b\", \"pairs\", \"mean_agreement\"]].to_excel(xl, sheet_name=\"Rater pairs\", index=False)\n",
    "    DIS.to_excel(xl, sheet_name=\"Disagreements\", index=False)\n",
    "    cov.to_excel(xl, sheet_name=\"Coverage\")\n",
    "    problems.to_excel(xl, sheet_name=\"Data checks\", index=False)\n",
    "    log.to_excel(xl, sheet_name=\"Exclusions and merges\", index=False)\n",
    "    ratings.to_excel(xl, sheet_name=\"Clean ratings\", index=False)\n",
    "print(\"saved\", EXPORT_XLSX)"
   ]
  }
 ],
