   "source": [
    "def show(t, title):\n",
    "    cols = [\"item\", \"n\", \"segments\", \"agree\", \"agree_lo\", \"agree_hi\", \"kappa\", \"kappa_lo\", \"kappa_hi\", \"strength\",\n",
    "            \"ac1\", \"w_kappa\", \"within1\", \"prevalence\"]\n",
    "    t = t[[c for c in cols if c in t]].set_index(\"item\")\n",
    "    fmt = {c: \"{:.1%}\" for c in (\"agree\", \"agree_lo\", \"agree_hi\", \"within1\", \"prevalence\") if c in t}\n",
    "    fmt.update({c: \"{:.2f}\" for c in (\"kappa\", \"kappa_lo\", \"kappa_hi\", \"ac1\", \"w_kappa\") if c in t})\n",
    "    display(Markdown(f\"### {title}\"))\n",
    "    display(t.style.format(fmt, na_rep=\"–\").background_gradient(subset=[\"agree\"], cmap=\"RdYlGn\", vmin=.5, vmax=1))\n",
    "\n",
    "overview = pd.DataFrame({k: {\"pairs\": len(COMPARISONS[k]), \"segments\": COMPARISONS[k].segment.nunique(),\n",
    "                             \"mean % agreement (28 items)\": t[\"agree\"].mean(),\n",
    "                             \"median kappa\": t[\"kappa\"].median(), \"median AC1\": t[\"ac1\"].median()}\n",
    "                         for k, t in RESULTS.items()}).T\n",
    "display(overview.style.format({\"mean % agreement (28 items)\": \"{:.1%}\", \"median kappa\": \"{:.2f}\", \"median AC1\": \"{:.2f}\",\n",
    "                               \"pairs\": \"{:.0f}\", \"segments\": \"{:.0f}\"}))\n",
    "for k, t in RESULTS.items():\n",
    "    show(t, k)"
   ]
  },
