    "def group_table(p):\n",
    "    out = {}\n",
    "    for g, its in GROUPS.items():\n",
    "        m = np.logical_and.reduce([usable(p, i) for i in its])\n",
    "        same = np.logical_and.reduce([p[f\"a_{i}\"] == p[f\"b_{i}\"] for i in its])\n",
    "        out[GROUP_NAME[g]] = {\"pairs\": int(m.sum()), \"all boxes match\": same[m].mean() if m.any() else np.nan}\n",
    "    return pd.DataFrame(out).T\n",
    "gq = pd.concat({k: group_table(p) for k, p in COMPARISONS.items() if len(p)}, axis=1)\n",
    "display(gq.style.format({c: \"{:.1%}\" for c in gq.columns if c[1] == \"all boxes match\"} |\n",
    "                        {c: \"{:.0f}\" for c in gq.columns if c[1] == \"pairs\"}, na_rep=\"–\"))"
   ]
  },
