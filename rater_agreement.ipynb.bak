   "id": "69b80506",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-11-20T16:36:06.214173Z",
     "iopub.status.busy": "2026-11-20T16:36:06.213937Z",
     "iopub.status.idle": "2026-11-20T16:36:06.217920Z",
     "shell.execute_reply": "2026-11-20T16:36:06.217104Z"
    }
   },
   "outputs": [],
   "source": [
    "AREA = os.environ.get(\"PEDS_AREA\", \"Chinatown\")      # \"Rockridge\" or \"Chinatown\"\n",
    "\n",
    "SHEET_ID = \"138fddMR4QTbVl-1OLKtzmpRe9e7AmBrOimVOB0XFACw\"\n",
    "TABS = {   # tab ids (the gid=... number in the sheet's address bar when that tab is open)\n",
    "    \"Rockridge\": {\"gsv\": [\"1106687304\"],                 # \"GSV entries\"\n",
    "                  \"field\": [\"1073847775\"]},              # \"Rockridge Field entries\"\n",
    "    \"Chinatown\": {\"gsv\": [\"1174797972\"],                 # \"Chinatown GSV entries\"\n",
    "                  \"field\": [\"1352016008\", \"91276802\"]},  # \"Chinatown Field 1\", \"Chinatown Field 2\"\n",
    "}\n",
    "VISIT_FOR_TAB = {\"1352016008\": 1, \"91276802\": 2}   # for tabs that have no visit column\n",
    "\n",
    "# Offline: a folder holding each tab as <gid>.csv. Leave as None to read the live sheet.\n",
    "CSV_DIR = os.environ.get(\"PEDS_CSV_DIR\") or None\n",
    "\n",
    "# Which field ratings count as a pair: \"any\" (default), \"same_visit\" (raters who walked together)\n",
    "# or \"across_visits\" (visit 1 vs visit 2, as in Chinatown).\n",
    "FIELD_PAIRING = \"any\"\n",
    "\n",
    "# Names are matched on the first word (\"Michael Huang\" = \"Michael\"). Add exceptions here.\n",
    "RATER_ALIASES = {}   # e.g. {\"Mike\": \"Michael\"}\n",
    "\n",
    "N_BOOT = 2000        # bootstrap resamples for the 95% intervals (set 0 to skip)\n",
    "SEED = 290\n",
    "EXPORT_XLSX = f\"{AREA}_rater_agreement.xlsx\""
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1667dcd5",
   "metadata": {},
   "source": [
    "## 2 · Codebook and area rules\n",
    "\n",
    "The 27 PEDS items plus Q13. Check-all questions are stored as one 0/1 column per box.\n",
    "\n",
    "The Chinatown rules are the alignment agreed earlier, giving 163 segments:\n",
    "- Route E is dropped, along with the six blocks that have no sidewalk and Alice St 10th–11th.\n",
    "- Seven pairs of half-blocks are joined. A rater who rated both halves is merged worst-case.\n",
    "- Three visit-2 placeholder rows are ignored.\n",
    "\n",
    "Rockridge needs no alignment: the 52 north box segments are used as they are."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "3062beab",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-11-20T16:36:06.219268Z",
     "iopub.status.busy": "2026-11-20T16:36:06.219128Z",
     "iopub.status.idle": "2026-11-20T16:36:06.225249Z",
     "shell.execute_reply": "2026-11-20T16:36:06.224474Z"
    }
   },
   "outputs": [],
   "source": [
    "ITEMS = [\"no_sidewalk\",\n",
    "         \"q4_footpath\", \"q4_paved_trail\", \"q4_sidewalk\", \"q4_ped_street\",\n",
    "         \"q5_asphalt\", \"q5_concrete\", \"q5_brick_stone\", \"q5_gravel\", \"q5_dirt_sand\",\n",
    "         \"q6_condition\",\n",
    "         \"q7_poles_signs\", \"q7_parked_cars\", \"q7_greenery\", \"q7_garbage_cans\", \"q7_other\", \"q7_none\",\n",
    "         \"q8_fence\", \"q8_trees\", \"q8_hedges\", \"q8_landscape\", \"q8_grass\", \"q8_none\",\n",
    "         \"q9_dist_from_curb\", \"q10_width\", \"q11_curb_cuts\", \"q12_complete\"]\n",
    "Q13 = \"q13_connections\"\n",
    "ALL = ITEMS + [Q13]\n",
    "GROUPS = {\"q4\": ITEMS[1:5], \"q5\": ITEMS[5:10], \"q7\": ITEMS[11:17], \"q8\": ITEMS[17:23]}\n",
    "GROUP_NAME = {\"q4\": \"Q4 Sidewalk type\", \"q5\": \"Q5 Path material\", \"q7\": \"Q7 Obstructions\", \"q8\": \"Q8 Buffers\"}\n",
    "BINARY = [\"no_sidewalk\"] + sum(GROUPS.values(), [])\n",
    "CODES = {\"q6_condition\": [1, 2, 3, 4], \"q9_dist_from_curb\": [1, 2, 3], \"q10_width\": [1, 2, 3],\n",
    "         \"q11_curb_cuts\": [1, 2, 3], \"q12_complete\": [1, 2]}\n",
    "ORDINAL = [\"q6_condition\", \"q9_dist_from_curb\", \"q10_width\", \"q11_curb_cuts\", Q13]\n",
    "LABEL = {\"no_sidewalk\": \"No sidewalk\", \"q4_footpath\": \"Q4 Footpath\", \"q4_paved_trail\": \"Q4 Paved trail\",\n",
    "         \"q4_sidewalk\": \"Q4 Sidewalk\", \"q4_ped_street\": \"Q4 Pedestrian street\", \"q5_asphalt\": \"Q5 Asphalt\",\n",
    "         \"q5_concrete\": \"Q5 Concrete\", \"q5_brick_stone\": \"Q5 Brick/stone\", \"q5_gravel\": \"Q5 Gravel\",\n",
    "         \"q5_dirt_sand\": \"Q5 Dirt/sand\", \"q6_condition\": \"Q6 Condition\", \"q7_poles_signs\": \"Q7 Poles/signs\",\n",
    "         \"q7_parked_cars\": \"Q7 Parked cars\", \"q7_greenery\": \"Q7 Greenery\", \"q7_garbage_cans\": \"Q7 Garbage cans\",\n",
    "         \"q7_other\": \"Q7 Other\", \"q7_none\": \"Q7 None\", \"q8_fence\": \"Q8 Fence\", \"q8_trees\": \"Q8 Trees\",\n",
    "         \"q8_hedges\": \"Q8 Hedges\", \"q8_landscape\": \"Q8 Landscape\", \"q8_grass\": \"Q8 Grass\", \"q8_none\": \"Q8 None\",\n",
    "         \"q9_dist_from_curb\": \"Q9 Distance from curb\", \"q10_width\": \"Q10 Width\", \"q11_curb_cuts\": \"Q11 Curb cuts\",\n",
    "         \"q12_complete\": \"Q12 Complete\", Q13: \"Q13 Connections\"}\n",
    "\n",
    "RULES = {\n",
    "    \"Rockridge\": dict(drop=set(), drop_prefix=(), alias={}, combine={}, placeholders=set()),\n",
    "    \"Chinatown\": dict(\n",
    "        # route E (6th St north side, Fallon St west side), blocks with no sidewalk, Lincoln Square Park\n",
    "        drop={\"10TH BWY–FRK N\", \"10TH BWY–FRK S\", \"10TH FRK–WEB N\", \"10TH FRK–WEB S\",\n",
    "              \"11TH OAK–FAL N\", \"11TH OAK–FAL S\", \"ALI 10–11 W\", \"ALI 10–11 E\"},\n",
    "        drop_prefix=(\"6TH \", \"FAL \"),\n",
    "        alias={\"BWY 9–11 E\": \"BWY 09–11 E\", \"FRK 9–11 W\": \"FRK 09–11 W\", \"FRK 9–11 E\": \"FRK 09–11 E\"},\n",
    "        combine={\"BWY 09–11 E\": [\"BWY 09–10 E\", \"BWY 10–11 E\"], \"FRK 09–11 W\": [\"FRK 09–10 W\", \"FRK 10–11 W\"],\n",
    "                 \"FRK 09–11 E\": [\"FRK 09–10 E\", \"FRK 10–11 E\"], \"WEB 09–11 W\": [\"WEB 09–10 W\", \"WEB 10–11 W\"],\n",
    "                 \"OAK 10–12 E\": [\"OAK 10–11 E\", \"OAK 11–12 E\"],\n",
    "                 \"10TH HAR–JAC N\": [\"10TH HAR–ALI N\", \"10TH ALI–JAC N\"],\n",
    "                 \"11TH HAR–JAC S\": [\"11TH HAR–ALI S\", \"11TH ALI–JAC S\"]},\n",
    "        # visit-2 rows marked \"no sidewalk\" with a \"combine\" note; the other half holds the rating\n",
    "        placeholders={\"BWY 10–11 E\", \"FRK 10–11 E\", \"FRK 09–10 W\"}),\n",
    "}\n",
    "R = RULES[AREA]\n",
    "HALF = {h: f for f, hs in R[\"combine\"].items() for h in hs}\n",
    "def final_code(code):\n",
    "    c = R[\"alias\"].get(code, code)\n",
    "    return HALF.get(c, c)\n",
    "def dropped(code):\n",
    "    return code in R[\"drop\"] or code.startswith(R[\"drop_prefix\"])"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ed324743",
   "metadata": {},
   "source": [
    "## 3 · Load and clean"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "27c2afd0",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-11-20T16:36:06.226787Z",
     "iopub.status.busy": "2026-11-20T16:36:06.226654Z",
     "iopub.status.idle": "2026-11-20T16:36:06.315237Z",
     "shell.execute_reply": "2026-11-20T16:36:06.314820Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "{'gsv': 384, 'field': 367} rows read; 737 rated rows after removing test rows\n"
     ]
    }
   ],
   "source": [
    "def read_tab(gid):\n",
    "    src = os.path.join(CSV_DIR, f\"{gid}.csv\") if CSV_DIR else \\\n",
    "          f\"https://docs.google.com/spreadsheets/d/{SHEET_ID}/export?format=csv&gid={gid}\"\n",
    "    raw = pd.read_csv(src, header=None, dtype=str, keep_default_na=False)\n",
    "    # the header is the first row naming seg_code/seg_num (Chinatown Field 1 has a label row above it)\n",
    "    hdr = next(i for i in range(min(5, len(raw))) if {\"seg_code\", \"seg_num\"} & set(raw.iloc[i].str.strip()))\n",
    "    cols = [c.strip() for c in raw.iloc[hdr]]\n",
    "    if \"seg_code\" not in cols and cols.count(\"seg_num\") > 1:      # Chinatown GSV: code column headed seg_num\n",
    "        cols[[i for i, c in enumerate(cols) if c == \"seg_num\"][1]] = \"seg_code\"\n",
    "    df = raw.iloc[hdr + 1:].copy()\n",
    "    df.columns = cols\n",
    "    df = df.loc[:, [c != \"\" for c in df.columns]]\n",
    "    df = df.loc[:, ~df.columns.duplicated()]\n",
    "    df[\"tab\"] = gid\n",
    "    return df.reset_index(drop=True)\n",
    "\n",
    "problems = []   # data-entry issues found while cleaning\n",
    "def note(df_row, method, item, issue):\n",
    "    problems.append(dict(method=method, seg_code=df_row[\"seg_code\"], rater=df_row[\"rater\"], item=item, issue=issue))\n",
    "\n",
    "def allowed(item, method):\n",
    "    if item in BINARY: return {0, 1}\n",
    "    if item in CODES: return set(CODES[item]) | ({9} if method == \"gsv\" else set())\n",
    "    return None   # Q13: any whole number\n",
    "\n",
    "def clean(df, method):\n",
    "    df = df.copy()\n",
    "    for c in df.columns:\n",
    "        df[c] = df[c].astype(str).str.strip()\n",
    "    df = df[df[\"seg_code\"] != \"\"]\n",
    "    test = df[\"rater\"].str.endswith(\"(TEST)\") | (df[\"rater\"] == \"__setup_test__\") | (df[\"seg_code\"] == \"SETUP-CHECK\")\n",
    "    df = df[~test & (df[\"rater\"] != \"\")].copy()\n",
    "    first = df[\"rater\"].str.split().str[0].str.title()\n",
    "    df[\"rater_id\"] = first.map(lambda r: RATER_ALIASES.get(r, r))\n",
    "    if method == \"field\":\n",
    "        v = pd.to_numeric(df[\"visit\"], errors=\"coerce\") if \"visit\" in df else pd.Series(np.nan, index=df.index)\n",
    "        df[\"visit\"] = v.fillna(df[\"tab\"].map(VISIT_FOR_TAB)).fillna(1).astype(int)\n",
    "    else:\n",
    "        df[\"visit\"] = 0\n",
    "    for c in ALL:\n",
    "        if c not in df: df[c] = \"\"\n",
    "    out = pd.DataFrame(index=df.index)\n",
    "    for it in ALL:\n",
    "        s = df[it]\n",
    "        num = pd.to_numeric(s, errors=\"coerce\")\n",
    "        ok = allowed(it, method)\n",
    "        bad = (s != \"\") & (num.isna() | (num % 1 != 0) | (num < 0) | (num.isin(ok) == False if ok else False))\n",
    "        for i in df.index[bad]:\n",
    "            note(df.loc[i], method, it, f\"value {s[i]!r} is not a valid code; treated as missing\")\n",
    "        out[it] = num.where(~bad)\n",
    "    if method == \"field\":\n",
    "        # Chinatown Field 1 left unchecked boxes blank: a blank box counts as 0 when its question was answered\n",
    "        answered = out[ALL].notna().any(axis=1)\n",
    "        out.loc[answered & out[\"no_sidewalk\"].isna(), \"no_sidewalk\"] = 0\n",
    "        for g, its in GROUPS.items():\n",
    "            any_yes = (out[its] == 1).any(axis=1) & (out[\"no_sidewalk\"] == 0)\n",
    "            out.loc[any_yes, its] = out.loc[any_yes, its].fillna(0)\n",
    "    else:\n",
    "        for g, its in GROUPS.items():                                   # \"can't tell\" box: the question is missing\n",
    "            ct = pd.to_numeric(df.get(f\"{g}_cant_tell\", \"\"), errors=\"coerce\") == 1\n",
    "            out.loc[ct, its] = np.nan\n",
    "        for it in CODES: out.loc[out[it] == 9, it] = np.nan              # 9 = can't tell\n",
    "        out.loc[out[Q13] == 99, Q13] = np.nan                            # 99 = can't tell\n",
    "    # contradictions worth a look: \"none\" checked together with another box\n",
    "    for g in (\"q7\", \"q8\"):\n",
    "        its = GROUPS[g]; none = its[-1]\n",
    "        clash = (out[none] == 1) & (out[its[:-1]] == 1).any(axis=1)\n",
    "        for i in df.index[clash]:\n",
    "            note(df.loc[i], method, none, \"'None' checked together with another box\")\n",
    "    meta = df[[\"seg_code\", \"rater\", \"rater_id\", \"visit\", \"tab\"] +\n",
    "              [c for c in (\"view_quality\", \"received_at\", \"saved_at\", \"note\") if c in df]]\n",
    "    res = pd.concat([meta, out], axis=1)\n",
    "    res[\"method\"] = method\n",
    "    res[\"blank\"] = out[ALL].isna().all(axis=1)\n",
    "    return res\n",
    "\n",
    "raw = {m: pd.concat([read_tab(g) for g in TABS[AREA][m]], ignore_index=True) for m in (\"gsv\", \"field\")}\n",
    "data = pd.concat([clean(raw[\"gsv\"], \"gsv\"), clean(raw[\"field\"], \"field\")], ignore_index=True)\n",
    "print({m: len(raw[m]) for m in raw}, \"rows read;\", len(data), \"rated rows after removing test rows\")"
   ]
  },
