    "# Keep one rating per segment, rater, visit and method (the latest one sent, when a rating was resent)\n",
    "log = []\n",
    "data[\"order\"] = pd.to_datetime(data.get(\"received_at\"), errors=\"coerce\", utc=True)\n",
    "data = data.sort_values(\"order\", kind=\"stable\", na_position=\"first\")\n",
    "dup = data.duplicated([\"method\", \"seg_code\", \"rater_id\", \"visit\"], keep=\"last\")\n",
    "for _, r in data[dup].iterrows():\n",
    "    log.append(dict(method=r.method, seg_code=r.seg_code, rater=r.rater_id, action=\"duplicate row; the latest copy was kept\"))\n",
    "data = data[~dup]\n",
    "\n",
    "# Area rules: drop segments that are not in the study, ignore blanks / not viewable / placeholders\n",
    "keep = []\n",
    "for _, r in data.iterrows():\n",
    "    why = None\n",
    "    if dropped(r.seg_code): why = \"segment not in the study area\"\n",
    "    elif r.blank: why = \"blank row (no answers)\"\n",
    "    elif r.method == \"gsv\" and str(r.get(\"view_quality\", \"\")).strip() == \"3\": why = \"marked not viewable in Street View\"\n",
    "    elif r.seg_code in R[\"placeholders\"] and r.no_sidewalk == 1: why = \"placeholder for a combined block; the other half was used\"\n",
    "    if why: log.append(dict(method=r.method, seg_code=r.seg_code, rater=r.rater_id, action=why))\n",
    "    keep.append(why is None)\n",
    "data = data[keep].copy()\n",
    "data[\"segment\"] = data[\"seg_code\"].map(final_code)\n",
    "\n",
    "def worst(rows):\n",
    "    # Merge halves of one block face rated separately: the poorer answer wins\n",
    "    m = {}\n",
    "    for it in ALL:\n",
    "        v = rows[it].dropna()\n",
    "        if v.empty: m[it] = np.nan\n",
    "        elif it.endswith(\"_none\"): m[it] = v.min()                         # 'none' only if both halves had none\n",
    "        elif it == \"q6_condition\": m[it] = v[v != 4].min() if (v != 4).any() else 4\n",
    "        elif it in (\"q9_dist_from_curb\", \"q10_width\"): m[it] = v.min()\n",
    "        else: m[it] = v.max()           # a box ticked on either half, more curb cuts, incomplete, more connections\n",
    "    return pd.Series(m)\n",
    "\n",
    "parts = []\n",
    "for key, g in data.groupby([\"method\", \"segment\", \"rater_id\", \"visit\"], sort=False):\n",
    "    if len(g) > 1:\n",
    "        log.append(dict(method=key[0], seg_code=key[1], rater=key[2],\n",
    "                        action=\"halves \" + \" + \".join(g.seg_code) + \" merged (worst case)\"))\n",
    "        row = worst(g)\n",
    "    else:\n",
    "        row = g.iloc[0][ALL]\n",
    "    parts.append(pd.concat([pd.Series(dict(zip([\"method\", \"segment\", \"rater_id\", \"visit\"], key))), row]))\n",
    "ratings = pd.DataFrame(parts).reset_index(drop=True)\n",
    "for c in ALL: ratings[c] = pd.to_numeric(ratings[c])\n",
    "log = pd.DataFrame(log, columns=[\"method\", \"seg_code\", \"rater\", \"action\"])\n",
    "problems = pd.DataFrame(problems, columns=[\"method\", \"seg_code\", \"rater\", \"item\", \"issue\"]).drop_duplicates()\n",
    "\n",
    "print(f\"{ratings.segment.nunique()} segments with at least one usable rating\")\n",
    "display(ratings.groupby([\"method\", \"rater_id\"]).size().unstack(0).fillna(0).astype(int).rename_axis(None))"
   ]
  },
